# Replace the key and model IDs with values available on your own provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
PLANNER_MODEL=gpt-4o
PERCEPTION_MODEL=gpt-4o

# Blank scoped values inherit the main URL and key.
PERCEPTION_BASE_URL=
PERCEPTION_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OMNIVQA_EMBEDDING_MODEL=text-embedding-3-small
AOAI_EMBEDDING_LARGE_DIM=1536
LLM_MAX_RETRIES=2

# Optional public web evidence. Leaving the search key empty disables this tool.
OMNIVQA_TAVILY_API_KEY=
OMNIVQA_JINA_API_KEY=
